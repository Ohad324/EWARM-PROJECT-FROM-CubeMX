/* gemini_4mhz_test.jlink — Gemini's 4 MHz PE2 test
 *
 * TARGET: 4.000 MHz sharp square wave on PE2 (SB45). Scope: 200 ns/div, 1 V/div.
 *
 * FIRMWARE: MCKDIV=8 + FRCR=0 (set in MX_SAI4_Init).
 *   Source = HSI 64 MHz, Total div = MCKDIV*2 = 16 → 64/16 = 4.000 MHz.
 *
 * LIVE DAP READS — CPU runs free, NO halts, periodic 250/200 ms cadence.
 *
 * 17 REGISTERS PER SAMPLE:
 *   [01] 0x58024400  RCC_CR
 *   [02] 0x58024450  RCC_D1CCIPR
 *   [03] 0x58024418  RCC_D3CFGR
 *   [04] 0x580244F4  RCC_APB4ENR     bit21=SAI4EN
 *   [05] 0x580244E0  RCC_AHB4ENR     bit4=GPIOEEN  bit21=BDMAEN
 *   [06] 0x58024458  RCC_D3CCIPR     SAI4ASEL[23:21] 100=CLKP
 *   [07] 0x58005404  SAI4 CR1        bit 0 SAIEN   (Gemini watch — toggle = engine reset)
 *   [08] 0x5800540C  SAI4 FRCR       (Gemini watch — MUST stay 0)
 *   [09] 0x58005444  SAI4 PDMCR      bit 8 CKEN1   (Gemini watch — MUST stay high)
 *   [10] 0x58005418  SAI4 SR         bit 3 OVRUDR  (Gemini watch — flip = 4MHz too fast for DMA)
 *   [11] 0x58021000  GPIOE MODER     PE2[5:4]=10 AF
 *   [12] 0x58021020  GPIOE AFRL      PE2[11:8]=A AF10
 *   [13] 0x58021008  GPIOE OSPEEDR   PE2[5:4]=11 VeryHigh
 *   [14] 0x5802541C  BDMA Ch1 CCR    EN[0]=1  CIRC[5]=1
 *   [15] 0x58025420  BDMA Ch1 CNDTR  live count
 *   [16] 0x58025424  BDMA Ch1 CPAR   want 0x58005420
 *   [17] 0x58025428  BDMA Ch1 CM0AR  want 0x38000000
 */

r
erase
loadfile "C:\TouchGFXProjects\MyApplication\EWARM\STM32H747I-DISCO_CM7\Exe\STM32H747I-DISCO_CM7.out"
r
g
sleep 200

