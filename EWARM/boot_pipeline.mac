/*
 * boot_pipeline.mac -- BP-driven boot pipeline probe (UCSARM-26 v9.50.x).
 *
 * Lifecycle: download flow (no --attach_to_running_target).
 *   1. cspybat downloads .out
 *   2. execUserSetup installs code breakpoints at peripheral-init entries
 *   3. CPU runs; each BP hit fires its action macro -> snapshot + clearBreak
 *   4. After all 4 BPs have hit and run their actions, the CPU continues
 *      free-running until execUserExit prints the final summary
 *
 * Execution control: NO __go / __stop (not in IAR macro language). The
 * action-string mechanism on each BP runs the snapshot inline.
 *
 * IAR C-SPY macro quirks (see CLAUDE.md "C-SPY Macro Reference"):
 *   - no preprocessor (no #define), no struct, no enum
 *   - __var locals only; types implicit
 *   - __readMemory32(addr, "Memory")  zone always "Memory"
 *   - __setCodeBreak(loc, skip, cond, action, name) -- 5 args
 */

/* --- helpers --- */

PrintHex32(label, v)
{
    __message "  ", label, " = 0x", v:%08X, "\n";
}

CheckBit(label, val, bit, expect_set)
{
    __var got;
    got = (val >> bit) & 1;
    if (got == expect_set)
        __message "  PASS ", label, "  bit", bit:%d, "=", got:%d, "\n";
    else
        __message "  FAIL ", label, "  bit", bit:%d, "=", got:%d, "  (expected ", expect_set:%d, ")\n";
}

DumpLtdcCore()
{
    __var gcr, l1pfcr, l1cfbar;
    gcr     = __readMemory32(0x50001018, "Memory");
    l1pfcr  = __readMemory32(0x50001094, "Memory");
    l1cfbar = __readMemory32(0x500010AC, "Memory");
    PrintHex32("LTDC GCR     ", gcr);
    PrintHex32("LTDC L1PFCR  ", l1pfcr);
    PrintHex32("LTDC L1CFBAR ", l1cfbar);
}

DumpDsiCore()
{
    __var dsi_cr, dsi_wcr;
    dsi_cr  = __readMemory32(0x50000004, "Memory");
    dsi_wcr = __readMemory32(0x50000024, "Memory");
    PrintHex32("DSI CR       ", dsi_cr);
    PrintHex32("DSI WCR      ", dsi_wcr);
}

DumpFb4()
{
    __var fb0, fb1, fb_mid, fb_far;
    fb0    = __readMemory32(0xD0000000, "Memory");
    fb1    = __readMemory32(0xD0000000 +  100*2496 + 100*3, "Memory");
    fb_mid = __readMemory32(0xD0000000 +  240*2496 + 400*3, "Memory");
    fb_far = __readMemory32(0xD0000000 +  240*2496 + 750*3, "Memory");
    PrintHex32("FB[0,0]      ", fb0);
    PrintHex32("FB[100,100]  ", fb1);
    PrintHex32("FB[240,400]  ", fb_mid);
    PrintHex32("FB[240,750]  ", fb_far);
}

ReadCycleCounter()
{
    /* DWT->CYCCNT at 0xE0001004. CoreDebug DEMCR.TRCENA bit24 + DWT
     * CYCCNTENA must be enabled by application (or by C-SPY at start). */
    __var c;
    c = __readMemory32(0xE0001004, "Memory");
    PrintHex32("DWT->CYCCNT  ", c);
}

/* --- BP action macros (called by C-SPY when each BP hits) --- */

/* BP1: vTaskStartScheduler entry -- end of Phase 1, kernel about to start.
 * Expectation: LTDC + DSI both DISABLED (silent boot premise). */
HitVTaskStartScheduler()
{
    __message "\n--- BP1 hit: vTaskStartScheduler entry (end of Phase 1) ---\n";
    DumpLtdcCore();
    DumpDsiCore();
    ReadCycleCounter();
    CheckBit("Phase 1: LTDC DISABLED (GCR.LTDCEN=0)",
             __readMemory32(0x50001018, "Memory"), 0, 0);
    CheckBit("Phase 1: DSI host DISABLED (CR.EN=0)",
             __readMemory32(0x50000004, "Memory"), 0, 0);
    __clearBreak(bp_vstart);
}

/* BP2: MX_DSIHOST_DSI_Init entry -- guiTask reached Phase 2 start. */
HitDsiInitEntry()
{
    __message "\n--- BP2 hit: MX_DSIHOST_DSI_Init entry (guiTask Phase 2 begin) ---\n";
    DumpLtdcCore();
    DumpDsiCore();
    ReadCycleCounter();
    __clearBreak(bp_dsi_init);
}

/* BP3: MX_LTDC_Init entry -- DSI just done, LTDC about to come up. */
HitLtdcInitEntry()
{
    __message "\n--- BP3 hit: MX_LTDC_Init entry (DSI just done, LTDC next) ---\n";
    DumpLtdcCore();
    DumpDsiCore();
    ReadCycleCounter();
    CheckBit("After DSI init: DSI host enabled (CR.EN=1)",
             __readMemory32(0x50000004, "Memory"), 0, 1);
    __clearBreak(bp_ltdc_init);
}

/* BP4: MX_TouchGFX_Init entry -- LTDC config done, framework about to start. */
HitTouchGFXInitEntry()
{
    __message "\n--- BP4 hit: MX_TouchGFX_Init entry (LTDC just configured) ---\n";
    DumpLtdcCore();
    ReadCycleCounter();
    CheckBit("After LTDC init: Layer1 CFBAR=0xD0000000",
             __readMemory32(0x500010AC, "Memory") == 0xD0000000 ? 1 : 0, 0, 1);
    __clearBreak(bp_tgfx_init);
}

/* --- BP handles (file-scope so action macros can clear them) --- */
__var bp_vstart;
__var bp_dsi_init;
__var bp_ltdc_init;
__var bp_tgfx_init;

/* --- entry: install BPs after firmware loaded --- */
execUserSetup()
{
    __message "\n*** boot_pipeline.mac (BP-driven) -- UCSARM-26 lifecycle ***\n";
    __message "    Hook: execUserSetup  (download flow, CPU @ reset vector)\n";

    /* Each BP: location, count_to_skip=0, condition='1' (always),
     * runs='TRUE', action='HitXxx()'. The action macro is called
     * automatically by C-SPY when the BP hits, then execution resumes. */
    bp_vstart    = __setCodeBreak("vTaskStartScheduler",     0, "1", "TRUE", "HitVTaskStartScheduler()");
    bp_dsi_init  = __setCodeBreak("MX_DSIHOST_DSI_Init",     0, "1", "TRUE", "HitDsiInitEntry()");
    bp_ltdc_init = __setCodeBreak("MX_LTDC_Init",            0, "1", "TRUE", "HitLtdcInitEntry()");
    bp_tgfx_init = __setCodeBreak("MX_TouchGFX_Init",        0, "1", "TRUE", "HitTouchGFXInitEntry()");

    __message "    BPs installed: vTaskStartScheduler, MX_DSIHOST_DSI_Init,\n";
    __message "                   MX_LTDC_Init, MX_TouchGFX_Init\n";
    __message "    CPU about to start running...\n\n";
}

execUserExit()
{
    __message "\n=========================================================\n";
    __message " boot_pipeline.mac DONE -- session ending, all BPs cleared\n";
    __message "=========================================================\n";
}
