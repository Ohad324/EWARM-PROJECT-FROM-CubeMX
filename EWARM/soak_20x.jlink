/* soak_20x.jlink — 20× recording soak test
 *
 * For each cycle:
 *   1. Pre-trigger snapshot: CH0 CFGR1 / FLT0ISR / FLT0RDATAR / DMA NDTR / s_DfsdmBuf[0..3]
 *   2. SW blue-button trigger (SWIER1 bit 13 → EXTI line 13)
 *   3. Wait 30 s for record (3s) + SD write + UART stream + cloud upload
 *   4. Post-trigger snapshot
 *
 * Cycle markers in log: "=== CYCLE N PRE ===" / "=== CYCLE N POST ==="
 *
 * Address map:
 *   0x40017000   DFSDM1_CH0->CHCFGR1        target 0x80310085
 *   0x40017108   DFSDM1_FLT0->FLTISR        bits[23:16] CKABF (CH0 bit = 0 when healthy)
 *   0x4001711C   DFSDM1_FLT0->FLTRDATAR     varies sample-to-sample if filter running
 *   0x4002002C   DMA1_Stream1->NDTR         live DMA count
 *   0x30004000   s_DfsdmBuf[0]              first PCM sample
 *   0x58000008   EXTI_D1->SWIER1            write bit13=1 to fire blue-button EXTI
 *   0x24000050   g_dbg.ch0_cfg1             snapshot from MX_DFSDM1_Init
 */

/* Connect without reset — chip keeps running */
sleep 200

/* ── CYCLE 1 ────────────────────────────────────────────────────────────── */
mem32 0x40017000 1
mem32 0x40017108 1
mem32 0x4001711C 1
mem32 0x4002002C 1
mem32 0x30004000 4
mem32 0x24000050 1
w4 0x58000008 0x00002000
sleep 30000
mem32 0x40017000 1
mem32 0x40017108 1
mem32 0x4001711C 1
mem32 0x4002002C 1
mem32 0x30004000 4
mem32 0x24000050 1

