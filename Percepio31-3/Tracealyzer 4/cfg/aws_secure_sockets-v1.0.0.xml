<?xml version="1.0" encoding="utf-8" ?>

<PlatformExtension>	
	
	<TargetPlatform>		
		<KernelServiceGroups>
			<KernelServiceGroup name="SOCKETS">
				<KernelService name="SOCKETS_Connect">
					<Parameter name="socket" format="Socket {0}" ioSource="true" />
					<Parameter name="addr"/>
				</KernelService>
				<KernelService name="SOCKETS_Recv" operation="OtherRead">
					<Parameter name="socket" format="Socket {0}" ioSource="true" />
					<ReturnValue name="bytes" format=" received {0} bytes" ioSize="true" />
				</KernelService>
				<KernelService name="SOCKETS_Send" operation="OtherWrite">
					<Parameter name="socket" format="Socket {0}" ioSource="true" />
					<ReturnValue name="bytes" format=" sent {0} bytes" ioSize="true" />
				</KernelService>				
			</KernelServiceGroup>
		</KernelServiceGroups>
		<ObjectClasses>
			<ObjectClass name="Socket" type="IOChannel"/>
		</ObjectClasses>
	</TargetPlatform>
		
	<EventCodes>
		<EventGroup name="SOCKETS">
			<Event code="0" service="SOCKETS/SOCKETS_Connect" type="KernelServiceReturn" status="StatusError">
				<Param index="0" type="Handle" class="Socket" useAs="Arg"></Param>
				<Param index="1" type="IPv4Address" useAs="Arg"></Param>
				<Param index="2" type="Int32" useAs="Return"></Param>				
				<Param index="2" type="Int32" useAs="ReturnStatus">
					<ReturnStatus value="0">StatusOK</ReturnStatus>
				</Param>
			</Event>
			<Event code="1" service="SOCKETS/SOCKETS_Send" type="KernelServiceReturn" status="StatusOK">
				<Param index="0" type="Handle" class="Socket" useAs="Arg"></Param>
				<Param index="1" type="Int32" useAs="Return"></Param>
				<Param index="1" type="Int32" useAs="ReturnStatus">
					<ReturnStatus value="0">StatusTimeout</ReturnStatus>
				</Param>
			</Event>
			<Event code="2" service="SOCKETS/SOCKETS_Recv" type="KernelServiceReturn" status="StatusOK">
				<Param index="0" type="Handle" class="Socket" useAs="Arg"></Param>
				<Param index="1" type="Int32" useAs="Return"></Param>
				<Param index="1" type="Int32" useAs="ReturnStatus">
					<ReturnStatus value="0">StatusTimeout</ReturnStatus>
				</Param>
			</Event> 					
		</EventGroup>
	</EventCodes>
	
	
</PlatformExtension>