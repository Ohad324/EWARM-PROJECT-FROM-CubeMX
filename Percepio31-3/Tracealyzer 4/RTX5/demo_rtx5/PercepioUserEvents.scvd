<?xml version="1.0" encoding="utf-8"?>

<component_viewer schemaVersion="0.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" 
  xs:noNamespaceSchemaLocation="Component_Viewer.xsd">

  <!--name and version of the component-->
  <component name="Percepio" version="1.0.0"/>
  
    <events>
		<group name="Tracealyzer Demo Events">
			<component name="Warnings" no="0xB0" />		
			<component name="Actuator" no="0xB1" />
			<component name="Sensor X" no="0xBA" />
			<component name="Sensor Y" no="0xBB" />
			<component name="Sensor Z" no="0xBC" />
		</group>

		<event id="0xB000" property="Msg"		value="%t[val1]" level="Error" />    
		<event id="0xB100" property="Output"	value="%d[val1]" />
		<event id="0xBA00" property="Input X"	value="%d[val1]" />
		<event id="0xBB00" property="Input Y"	value="%d[val1]" />
		<event id="0xBC00" property="Input Z"	value="%d[val1]" />   
  </events>

</component_viewer>


