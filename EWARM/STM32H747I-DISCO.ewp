                    <option>
                        <name>CCPreprocFile</name>
                        <state>0</state>
                    </option>
                    <option>
                        <name>CCPreprocComments</name>
                        <state>0</state>
                    </option>
                    <option>
                        <name>CCPreprocLine</name>
                        <state>0</state>
                    </option>
                    <option>
                        <name>CCListCFile</name>
                        <state>0</state>
                    </option>
