si SWD
speed 4000
device STM32H747XI_M7
connect

// Force D3CCIPR and trigger
w4 0x58024454 0x00800000
w4 0x58000088 0x00002000
w4 0x58000008 0x00002000
g
sleep 1000
h

// DFSDM1_Filter0 FLTRDATAR at CORRECT offset 0x1C
// DFSDM1_Filter0 base = 0x40017100
// FLTRDATAR @ base+0x1C = 0x4001711C
mem32 0x4001711C 1

// DFSDM1_Filter0 FLTJDATAR @ base+0x18 = 0x40017118
mem32 0x40017118 1

// DMA1_Stream1 registers
// DMA1_BASE = 0x40020000
// Stream1_BASE = DMA1_BASE + 0x028 = 0x40020028
// Stream1 CR  @ 0x40020028
mem32 0x40020028 1
// Stream1 NDTR @ 0x4002002C
mem32 0x4002002C 1
// Stream1 PAR  @ 0x40020030
mem32 0x40020030 1
// Stream1 M0AR @ 0x40020034
mem32 0x40020034 1

// GPIOC IDR — PC1 level (bit1)
mem32 0x58020810 1

// g_DfsdmBuf - first 8 words
mem32 0x30000000 8

// g_SampleCount
mem32 0x240377FC 1

g
exit
