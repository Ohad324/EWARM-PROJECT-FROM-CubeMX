// ================================================================
// auto_trigger_dump.jlink — Simulate blue button + mid-recording dump
// STM32H747I-DISCO CM7
//
// EXTI_SWIER1 = 0x58000418  bit13 = PC13 software trigger
// EXTI_PR1    = 0x58000488  write 1<<13 to clear pending
// g_State     = 0x24037876  (0=idle, 1=rec, 2=save)  ← from current map
//
// This script:
//   1. Connects without halting
//   2. Fires EXTI13 software trigger (simulates blue button)
//   3. Sleeps 1500ms for recording to start
//   4. Halts and dumps all registers (mid-recording)
//   5. Resumes, sleeps 2000ms for recording to finish
//   6. Halts and dumps again (post-recording)
// ================================================================

si SWD
speed 4000
device STM32H747XI_M7
connect

// ── Step 1: Resume target (D3 domain must be running for writes) ─
// C1IMR1 is a D3 domain register — writes while halted are dropped.
// All EXTI writes must happen while the CPU is running.
g

// ── Step 2: Clear stale EXTI13 pending flag ──────────────────────
w4 0x58000488 0x00002000

// ── Step 3: Unmask EXTI13 in CPU1 interrupt mask register ────────
// bit13=EXTI13, bit16=PVD (already set — preserve it)
w4 0x58000500 0x00012000

// ── Step 4: Fire EXTI13 software trigger (blue button press) ─────
w4 0x58000418 0x00002000

// ── Step 5: Wait 1500ms for recording to start ───────────────────
sleep 1500

// ── Step 4: Halt and dump mid-recording ──────────────────────────
h

// g_State
echo "=== MID-RECORDING: g_State (expect 1) ==="
mem8 0x24037876 1

// SAI4 CR1 — SAIEN + MCKDIV
echo "=== SAI4 CR1 (expect SAIEN=1, MCKDIV=0x10) ==="
mem32 0x58005404 1

// DFSDM FLTISR — CKABF
echo "=== DFSDM FLTISR (expect CKABF=0x00) ==="
mem32 0x40017108 1

// DFSDM FLTRDATAR — audio data
echo "=== FLTRDATAR (expect varying, NOT 0xFF88CA01) ==="
mem32 0x4001711C 1

// PE2 IDR level
echo "=== GPIOE IDR — PE2(CK1) bit2 (expect 1 = clock toggling) ==="
mem32 0x58020410 1

// PC1 IDR level
echo "=== GPIOC IDR — PC1(D1) bit1 (expect varying) ==="
mem32 0x58020810 1

// DMA1 Stream1 CR + NDTR
echo "=== DMA1 Stream1 CR (expect EN=1) ==="
mem32 0x40020028 1
echo "=== DMA1 Stream1 NDTR (expect counting down) ==="
mem32 0x4002002C 1

// g_SampleCount
echo "=== g_SampleCount (expect >0 and <48000) ==="
mem32 0x240377FC 1

// ── Step 5: Resume and wait for recording to finish ───────────────
g
sleep 2500

// ── Step 6: Halt and dump post-recording ─────────────────────────
h

echo ""
echo "=== POST-RECORDING: g_State (expect 0 or 2) ==="
mem8 0x24037876 1

echo "=== FLTRDATAR post ==="
mem32 0x4001711C 1

echo "=== FLTISR post ==="
mem32 0x40017108 1

echo "=== g_SampleCount post (expect 48000) ==="
mem32 0x240377FC 1

// Resume and exit
g
exit
