si SWD
speed 4000
device STM32H747XI_M7
connect
go

// Trigger EXTI line 13 via SWIER1
w4 0x58000008 0x00002000
sleep 500

// Wait: 300ms warmup + 3s record + ~2s SD write + ~10s stream = 16s total
// Use 8s — enough to confirm recording+save complete, streaming may still be in progress
sleep 8000

// Read g_State
mem8 0x24056E68 1

// Read g_SampleCount
mem32 0x24056E18 1

// Save audio buffer
SaveBin "C:\TouchGFXProjects\MyApplication\EWARM\SystemView\audio_buf.bin" 0x24018DC0 0x17700

exit
