/*
 * dfsdm_3dump.mac — CSpyBat headless macro: 3 timed register dumps
 *
 * DUMP 1: At main() — before peripheral init
 * (firmware boots, FreeRTOS starts)
 * SW trigger blue button (EXTI13)
 * DUMP 2: 1.5s after trigger — mid-recording
 * DUMP 3: 5.0s after trigger — post-recording
 *
 * Correct DFSDM base addresses (verified from stm32h747xx.h):
 *   DFSDM1_Channel0  = 0x40017000
 *   DFSDM1_Channel1  = 0x40017020
 *   DFSDM1_Filter0   = 0x40017100
 *   SAI4_Block_A     = 0x58005404
 *   DMA1_Stream1 CR  = 0x40020028
 *
 * Usage: run via dfsdm_3dump_cycle.bat
 */

dfsdm_dump(tag)
{
    __var ch0cfg1, ch1cfg1, ch1cfg2, fltcr1, fltcr2, fltfcr, fltisr, fltrdatar;
    __var sai4cr1, sai4cr2, sai4slotr, sai4sr, sai4dr, pdmcr, pdmdly;
    __var dmacr, dmandtr, dmapar, dmam0ar, dmalisr;
    __var rcc_apb2, rcc_c1apb2, rcc_apb4, rcc_ahb1, rcc_ahb4;
    __var gpioc_moder, gpioc_afrl, gpioc_idr, gpioc_pupdr;
    __var gpioe_moder, gpioe_afrl, gpioe_idr;
    __var state, sampleCnt, fileIdx;

    /* ── RCC clocks ── */
    rcc_apb2   = __readMemory32(0x580244F0, "Memory");
    rcc_c1apb2 = __readMemory32(0x58024590, "Memory");
    rcc_apb4   = __readMemory32(0x580244F8, "Memory");
    rcc_ahb1   = __readMemory32(0x580244D8, "Memory");
    rcc_ahb4   = __readMemory32(0x580244E0, "Memory");

    /* ── DFSDM1 Channel 0 (clock master, 0x40017000) ── */
    ch0cfg1 = __readMemory32(0x40017000, "Memory");

    /* ── DFSDM1 Channel 1 (data channel, 0x40017020) ── */
    ch1cfg1 = __readMemory32(0x40017020, "Memory");
    ch1cfg2 = __readMemory32(0x40017024, "Memory");

    /* ── DFSDM1 Filter 0 (0x40017100) ── */
    fltcr1    = __readMemory32(0x40017100, "Memory");
    fltcr2    = __readMemory32(0x40017104, "Memory");
    fltisr    = __readMemory32(0x40017108, "Memory");
    fltfcr    = __readMemory32(0x40017114, "Memory");
    fltrdatar = __readMemory32(0x4001711C, "Memory");

    /* ── SAI4 Block A (0x58005404) ── */
    sai4cr1   = __readMemory32(0x58005404, "Memory");
    sai4cr2   = __readMemory32(0x58005408, "Memory");
    sai4slotr = __readMemory32(0x58005410, "Memory");
    sai4sr    = __readMemory32(0x58005418, "Memory");
    sai4dr    = __readMemory32(0x58005420, "Memory");
    pdmcr     = __readMemory32(0x58005444, "Memory");
    pdmdly    = __readMemory32(0x58005448, "Memory");

    /* ── DMA1 Stream 1 (0x40020028) ── */
    dmacr   = __readMemory32(0x40020028, "Memory");
    dmandtr = __readMemory32(0x4002002C, "Memory");
    dmapar  = __readMemory32(0x40020030, "Memory");
    dmam0ar = __readMemory32(0x40020034, "Memory");
    dmalisr = __readMemory32(0x40020000, "Memory");

    /* ── GPIO ── */
    gpioc_moder = __readMemory32(0x58020800, "Memory");
    gpioc_pupdr = __readMemory32(0x5802080C, "Memory");
    gpioc_afrl  = __readMemory32(0x58020820, "Memory");
    gpioc_idr   = __readMemory32(0x58020810, "Memory");
    gpioe_moder = __readMemory32(0x58021000, "Memory");
    gpioe_afrl  = __readMemory32(0x58021020, "Memory");
    gpioe_idr   = __readMemory32(0x58021010, "Memory");

    /* ── Firmware state (from linker map) ── */
    sampleCnt = __readMemory32(0x24037784, "Memory");
    fileIdx   = __readMemory32(0x24037790, "Memory");
    state     = __readMemory8(0x240377FE, "Memory");

    /* ════════════════════ PRINT ════════════════════ */
    __message "\n================================================================";
    __message "  DUMP: ", tag;
    __message "================================================================";

    __message "\n── RCC CLOCKS ──";
    __message "  APB2ENR=0x", rcc_apb2:%X,
              "  DFSDM1EN(bit28)=", (rcc_apb2 >> 28) & 1:%d;
    __message "  C1_APB2ENR=0x", rcc_c1apb2:%X,
              "  CM7_gate(bit28)=", (rcc_c1apb2 >> 28) & 1:%d;
    __message "  APB4ENR=0x", rcc_apb4:%X,
              "  SAI4EN(bit21)=", (rcc_apb4 >> 21) & 1:%d;
    __message "  AHB1ENR=0x", rcc_ahb1:%X,
              "  DMA1EN(bit0)=", rcc_ahb1 & 1:%d;
    __message "  AHB4ENR=0x", rcc_ahb4:%X,
              "  GPIOCEN(bit2)=", (rcc_ahb4 >> 2) & 1:%d,
              "  GPIOEEN(bit4)=", (rcc_ahb4 >> 4) & 1:%d;

    __message "\n── DFSDM1 CH0 (clock master, 0x40017000) ──";
    __message "  CHCFGR1=0x", ch0cfg1:%X;
    __message "    DFSDMEN(bit31)=", (ch0cfg1 >> 31) & 1:%d,
              "  CKOUTDIV[22:16]=", (ch0cfg1 >> 16) & 0x7F:%d,
              "  CHEN(bit7)=", (ch0cfg1 >> 7) & 1:%d;

    __message "\n── DFSDM1 CH1 (data, 0x40017020) ──";
    __message "  CHCFGR1=0x", ch1cfg1:%X;
    __message "    SITP[1:0]=", ch1cfg1 & 3:%d,
              "  (0=rising, 1=falling)";
    __message "    SPICKSEL[3:2]=", (ch1cfg1 >> 2) & 3:%d,
              "  (0=ext, 1=CKOUT, 2=CKOUT/2fall, 3=CKOUT/2rise)";
    __message "    CHEN(bit7)=", (ch1cfg1 >> 7) & 1:%d;
    __message "    CHINSEL(bit8)=", (ch1cfg1 >> 8) & 1:%d;
    __message "    DATMPX[13:12]=", (ch1cfg1 >> 12) & 3:%d,
              "  (0=ext DATIN, 1=ADC, 2=CPU)";
    __message "  CHCFGR2=0x", ch1cfg2:%X,
              "  DTRBS[7:3]=", (ch1cfg2 >> 3) & 0x1F:%d;
    __message "  CHDATINR=0x", __readMemory32(0x40017030, "Memory"):%X;

    __message "\n── DFSDM1 FLT0 (0x40017100) ──";
    __message "  FLTCR1=0x", fltcr1:%X;
    __message "    RCSEL[27:24]=", (fltcr1 >> 24) & 0xF:%d,
              "  RDMAEN(bit21)=", (fltcr1 >> 21) & 1:%d,
              "  RCONT(bit18)=", (fltcr1 >> 18) & 1:%d;
    __message "    RSWSTART(bit17)=", (fltcr1 >> 17) & 1:%d,
              "  FAST(bit29)=", (fltcr1 >> 29) & 1:%d,
              "  DFEN(bit0)=", fltcr1 & 1:%d;
    __message "  FLTCR2=0x", fltcr2:%X;
    __message "  FLTISR=0x", fltisr:%X;
    __message "    CKABF[23:16]=0x", (fltisr >> 16) & 0xFF:%X,
              "  ROVRF(bit3)=", (fltisr >> 3) & 1:%d,
              "  REOCF(bit1)=", (fltisr >> 1) & 1:%d;
    __message "  FLTFCR=0x", fltfcr:%X;
    __message "    FORD[31:29]=", (fltfcr >> 29) & 7:%d,
              " (3=Sinc3)  FOSR[25:16]=", (fltfcr >> 16) & 0x3FF:%d,
              " (124=OSR-1 -> OSR=125)";
    __message "  FLTRDATAR=0x", fltrdatar:%X,
              "  DATA(>>8)=", fltrdatar >> 8:%d;

    __message "\n── SAI4 BLOCK A (0x58005404) ──";
    __message "  CR1=0x", sai4cr1:%X,
              "  SAIEN(bit16)=", (sai4cr1 >> 16) & 1:%d,
              "  MCKDIV[23:20]=", (sai4cr1 >> 20) & 0xF:%d,
              "  MODE[1:0]=", sai4cr1 & 3:%d;
    __message "  CR2=0x", sai4cr2:%X;
    __message "  SLOTR=0x", sai4slotr:%X;
    __message "  SR=0x", sai4sr:%X,
              "  FREQ(bit1)=", (sai4sr >> 1) & 1:%d,
              "  OVRUDR(bit0)=", sai4sr & 1:%d;
    __message "  DR=0x", sai4dr:%X;
    __message "  PDMCR=0x", pdmcr:%X,
              "  PDMEN(bit0)=", pdmcr & 1:%d,
              "  CKEN1(bit8)=", (pdmcr >> 8) & 1:%d;
    __message "  PDMDLY=0x", pdmdly:%X;

    __message "\n── DMA1 STREAM 1 (0x40020028) ──";
    __message "  CR=0x", dmacr:%X,
              "  EN(bit0)=", dmacr & 1:%d,
              "  CIRC(bit8)=", (dmacr >> 8) & 1:%d,
              "  TCIE(bit4)=", (dmacr >> 4) & 1:%d,
              "  HTIE(bit3)=", (dmacr >> 3) & 1:%d;
    __message "  NDTR=", dmandtr:%d,
              "  (32=idle/stalled, <32=DMA moving)";
    __message "  PAR=0x", dmapar:%X,
              "  (expect 0x4001711C=FLTRDATAR)";
    __message "  M0AR=0x", dmam0ar:%X,
              "  (expect 0x30000000=g_DfsdmBuf)";
    __message "  LISR=0x", dmalisr:%X;

    __message "\n── GPIO PIN MUX ──";
    __message "  PC1: mode=", (gpioc_moder >> 2) & 3:%d,
              "(2=AF)  AF=", (gpioc_afrl >> 4) & 0xF:%d,
              "(10=SAI4_D1)  pull=", (gpioc_pupdr >> 2) & 3:%d,
              "  level=", (gpioc_idr >> 1) & 1:%d;
    __message "  PE2: mode=", (gpioe_moder >> 4) & 3:%d,
              "(2=AF)  AF=", (gpioe_afrl >> 8) & 0xF:%d,
              "(10=SAI4_CK1)  level=", (gpioe_idr >> 2) & 1:%d;

    __message "\n── FIRMWARE STATE ──";
    __message "  g_State=", state:%d,
              " (0=idle, 1=rec, 2=save)";
    __message "  g_SampleCount=", sampleCnt:%d;
    __message "  g_FileIndex=", fileIdx:%d;

    __message "\n── g_dbg HUB (0x24000050) ──";
    __message "  ch0_cfg1=0x", __readMemory32(0x24000050, "Memory"):%X,
              "  ch0_cfg2=0x", __readMemory32(0x24000054, "Memory"):%X;
    __message "  flt0_cr1=0x", __readMemory32(0x24000058, "Memory"):%X,
              "  flt0_cr2=0x", __readMemory32(0x2400005C, "Memory"):%X;
    __message "  last_raw=0x", __readMemory32(0x24000084, "Memory"):%X,
              "  last_val=", __readMemory32(0x24000088, "Memory"):%d;

    __message "\n── LIVE GLOBALS ──";
    __message "  sai4_cr1=0x", __readMemory32(0x240000E8, "Memory"):%X,
              "  fltisr=0x", __readMemory32(0x240000EC, "Memory"):%X;
    __message "  hal_ok=0x", __readMemory32(0x240000F0, "Memory"):%X,
              "  fltcr1=0x", __readMemory32(0x240000F4, "Memory"):%X;

    __message "\n── BUFFER SAMPLES ──";
    __message "  DfsdmBuf[0..7] @ 0x30000000:";
    __message "    ", __readMemory32(0x30000000, "Memory"):%d,
              "  ", __readMemory32(0x30000004, "Memory"):%d,
              "  ", __readMemory32(0x30000008, "Memory"):%d,
              "  ", __readMemory32(0x3000000C, "Memory"):%d;
    __message "    ", __readMemory32(0x30000010, "Memory"):%d,
              "  ", __readMemory32(0x30000014, "Memory"):%d,
              "  ", __readMemory32(0x30000018, "Memory"):%d,
              "  ", __readMemory32(0x3000001C, "Memory"):%d;

    __message "================================================================\n";
}

execUserSetup()
{
    __message "\n************************************************************";
    __message "  dfsdm_3dump.mac — 3 timed register dumps";
    __message "  DUMP 1: at main (pre-init)";
    __message "  DUMP 2: 1.5s after blue button (mid-recording)";
    __message "  DUMP 3: 5.0s after blue button (post-recording)";
    __message "************************************************************\n";

    /* ── DUMP 1: At main — peripherals not yet initialized ──────── */
    dfsdm_dump("1/3  AT MAIN (before peripheral init)");

    /* Let firmware run: MX_DFSDM1_Init, MX_SAI4_Init, FreeRTOS start */
    __go();
    __delay(5000);
    __halt();

    __message "\n>>> Firmware booted. Triggering blue button (EXTI13 SW) <<<\n";

    /* Software-trigger blue button: EXTI_D1->SWIER1 bit13 */
    __writeMemory32(0x00002000, 0x58000008, "Memory");
    __message ">>> SWIER1 written: 0x00002000 -> 0x58000008 <<<\n";

    __go();
    __delay(1500);
    __halt();

    /* ── DUMP 2: 1.5s after trigger — mid-recording ─────────────── */
    dfsdm_dump("2/3  MID-RECORDING (1.5s after trigger)");

    __go();
    __delay(3500);
    __halt();

    /* ── DUMP 3: 5.0s after trigger — post-recording ────────────── */
    dfsdm_dump("3/3  POST-RECORDING (5.0s after trigger)");

    __message "\n************************************************************";
    __message "  ALL 3 DUMPS COMPLETE";
    __message "************************************************************";
    __message "KEY CHECKS:";
    __message "  DUMP1: everything should be 0 (pre-init)";
    __message "  DUMP2: DFEN=1 RDMAEN=1 RSWSTART=1 DMA_EN=1 NDTR<32 SAI4_SAIEN=1";
    __message "  DUMP3: g_State=0(idle) or 2(save), g_SampleCount>0";
    __message "  ALL:   FLTRDATAR DATA != -30518 means real mic data";
    __message "************************************************************\n";
}
