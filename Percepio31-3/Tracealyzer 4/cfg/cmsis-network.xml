    <StateMachineModels>
      <!--
        Disabling the state unused parts of the model.
      -->
      <StateMachineModel name="TCP Connection State">
        <States>
          <!--
            <State id="0" name="UNUSED">
            </State>
          -->
          <State id="CLOSED" name="CLOSED">
          </State>
          <State id="LISTEN" name="LISTEN">
            <ExpectedTransitions>
              <Transition>SYN_RECEIVED</Transition>
            </ExpectedTransitions>
          </State>
          <State id="SYN_RECEIVED" name="SYN_RECEIVED">
            <ExpectedTransitions>
              <Transition>ESTABLISHED</Transition>
            </ExpectedTransitions>
          </State>
          <State id="SYN_SENT" name="SYN_SENT">
          </State>
          <State id="FIN_WAIT_1" name="FIN_WAIT_1">
            <ExpectedTransitions>
              <Transition>FIN_WAIT_2</Transition>
              <Transition>TIME_WAIT</Transition>
            </ExpectedTransitions>
          </State>
          <State id="FIN_WAIT_2" name="FIN_WAIT_2">
            <ExpectedTransitions>
              <Transition>TIME_WAIT</Transition>
            </ExpectedTransitions>
          </State>
          <State id="CLOSING" name="CLOSING">
          </State>
          <State id="LAST_ACK" name="LAST_ACK">
          </State>
          <State id="TIME_WAIT" name="TIME_WAIT">
            <ExpectedTransitions>
              <Transition>LISTEN</Transition>
              <Transition>ESTABLISHED</Transition>
            </ExpectedTransitions>
          </State>
          <State id="ESTABLISHED" name="ESTABLISHED">
            <ExpectedTransitions>
              <Transition>LISTEN</Transition>
              <Transition>FIN_WAIT_1</Transition>
              <Transition>FIN_WAIT_2</Transition>
            </ExpectedTransitions>
          </State>
        </States>
      </StateMachineModel>
    </StateMachineModels>

    <ObjectClasses>
      <ObjectClass name="Network Memory Pool" type="Heap" options="NoIpcGraph|Internal|SizeOnly" />
      <ObjectClass name="TCP Socket" type="IOChannel" >
        <StateMachineModels>
          <StateMachineModel name="TCP Connection State"/>
        </StateMachineModels>
      </ObjectClass>
      <ObjectClass name="UDP Socket" type="IOChannel" />
    </ObjectClasses>
  </TargetPlatform>
</PlatformExtension>
