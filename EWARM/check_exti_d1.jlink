si SWD
speed 4000
device STM32H747XI_M7
connect
go

// EXTI base = 0x58000000
// EXTI_D1 = EXTI_BASE + 0x80 = 0x58000080
// EXTI_D1 IMR1 (offset 0) = 0x58000080  -- D1 interrupt mask
// EXTI_D1 EMR1 (offset 4) = 0x58000084
// EXTI RTSR1 (offset 0x20) = 0x58000020  -- rising trigger
// EXTI SWIER1 (offset 0x08) = 0x58000008

// Read EXTI_D1 IMR1 — bit13 must be 1 for EXTI15_10 to reach NVIC
mem32 0x58000080 1

// Read EXTI RTSR1
mem32 0x58000020 1

// Read EXTI FTSR1
mem32 0x58000024 1

// Read EXTI PR1 (pending)
mem32 0x58000088 1

// Now trigger via SWIER1
w4 0x58000008 0x00002000
sleep 100

// Check state changed
mem8 0x24056E68 1
mem32 0x58000088 1

exit
