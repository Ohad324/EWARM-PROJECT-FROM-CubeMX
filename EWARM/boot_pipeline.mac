/*
 * boot_pipeline.mac -- Single-snapshot boot probe via __setCodeBreak action.
 *
 * Why this design and not sequential __hwRunToBreakpoint?
 *   In CSpyBat 9.4.6.1706 (bundled with EWARM 9.70.2), tested with
 *   J-Link DLL V9.30.x and V9.34b, __hwRunToBreakpoint raises:
 *       Fatal error: Unknown exception in driver __hwRunToBreakpoint
 *   on the very first call regardless of target address.  See CLAUDE.md
 *   "C-SPY Macro and cspybat Syntax Reference" for the full investigation.
 *
 *   Action-on-BP (this file) works for the first BP that fires.  The
 *   session ends after that, but a single comprehensive snapshot at the
 *   right checkpoint is enough to verify Phase 1 silent boot.
 *
 * Lifecycle (per UCSARM-26):
 *   execUserSetup       installs 4 code breakpoints across the boot path
 *                       and an action macro on each that dumps the full
 *                       peripheral register block + DWT->CYCCNT
 *   CPU runs from reset -- the first BP encountered (SystemInit) fires
 *                       and runs the action; cspybat then exits cleanly
 *   execUserExit        prints final banner
 *
 * For multi-checkpoint debugging, the working alternative in this project
 * is boot_pipeline.bat (J-Link Commander mem32 sampling at fixed time).
 *
 * Macro language quirks (project-discovered):
 *   - no preprocessor (no #define / #include / #ifdef)
 *   - %02d in __message format string parses as octal literal -- use %d
 *   - SDRAM (0xD0000000) read pre-MX_FMC_Init bus-faults the macro engine
 *   - __symbolAddress() not in IAR EW 9.4.6 -- use & address-of operator
 *   - __hwRunToBreakpoint not implemented for J-Link in this cspybat
 */

/* --- helpers --- */

ReadCycle()
{
    __var c;
    c = __readMemory32(0xE0001004, "Memory");
    __message "    cyc=0x", c:%08X, "\n";
}

DumpKeyRegs()
{
    /* Comprehensive peripheral aperture dump.
     * Do NOT read SDRAM (0xD0000000) here -- bus-faults pre-MX_FMC_Init. */
    __var rcc_cr, rcc_cfgr, rcc_pllckselr, rcc_d1cfgr;
    __var rcc_ahb1, rcc_ahb3, rcc_ahb4, rcc_apb2enr, rcc_apb3enr;
    __var flash_acr, pwr_d3cr;
    __var fmc_sdcr1, mpu_ctrl, scb_ccr;
    __var ltdc_gcr, ltdc_isr, ltdc_l1pfcr, ltdc_l1cfbar;
    __var dsi_cr, dsi_wcr;
    __var gpioe_moder, gpioc_moder;

    rcc_cr        = __readMemory32(0x58024400, "Memory");
    rcc_cfgr      = __readMemory32(0x58024410, "Memory");
    rcc_pllckselr = __readMemory32(0x58024428, "Memory");
    rcc_d1cfgr    = __readMemory32(0x58024418, "Memory");
    rcc_ahb1      = __readMemory32(0x580244D8, "Memory");
    rcc_ahb3      = __readMemory32(0x580244D4, "Memory");
    rcc_ahb4      = __readMemory32(0x580244E0, "Memory");
    rcc_apb2enr   = __readMemory32(0x580244F0, "Memory");
    rcc_apb3enr   = __readMemory32(0x580244E4, "Memory");
    flash_acr     = __readMemory32(0x52002000, "Memory");
    pwr_d3cr      = __readMemory32(0x58024818, "Memory");
    fmc_sdcr1     = __readMemory32(0x52004140, "Memory");
    mpu_ctrl      = __readMemory32(0xE000ED94, "Memory");
    scb_ccr       = __readMemory32(0xE000ED14, "Memory");
    ltdc_gcr      = __readMemory32(0x50001018, "Memory");
    ltdc_isr      = __readMemory32(0x50001038, "Memory");
    ltdc_l1pfcr   = __readMemory32(0x50001094, "Memory");
    ltdc_l1cfbar  = __readMemory32(0x500010AC, "Memory");
    dsi_cr        = __readMemory32(0x50000004, "Memory");
    dsi_wcr       = __readMemory32(0x50000024, "Memory");
    gpioe_moder   = __readMemory32(0x58021000, "Memory");
    gpioc_moder   = __readMemory32(0x58020800, "Memory");

    __message "    RCC.CR=0x",   rcc_cr:%08X,        "  CFGR=0x",      rcc_cfgr:%08X,
              "  PLLCKSEL=0x",   rcc_pllckselr:%08X, "  D1CFGR=0x",    rcc_d1cfgr:%08X, "\n";
    __message "    AHB1=0x",     rcc_ahb1:%08X,      "  AHB3=0x",      rcc_ahb3:%08X,
              "  AHB4=0x",       rcc_ahb4:%08X,      "  APB2=0x",      rcc_apb2enr:%08X,
              "  APB3=0x",       rcc_apb3enr:%08X, "\n";
    __message "    FLASH=0x",    flash_acr:%08X,     "  PWR.D3CR=0x",  pwr_d3cr:%08X,
              "  FMC.SDCR1=0x",  fmc_sdcr1:%08X, "\n";
    __message "    MPU.CTRL=0x", mpu_ctrl:%08X,      "  SCB.CCR=0x",   scb_ccr:%08X, "\n";
    __message "    LTDC.GCR=0x", ltdc_gcr:%08X,      "  ISR=0x",       ltdc_isr:%08X,
              "  L1PFCR=0x",     ltdc_l1pfcr:%08X,   "  L1CFBAR=0x",   ltdc_l1cfbar:%08X, "\n";
    __message "    DSI.CR=0x",   dsi_cr:%08X,        "  WCR=0x",       dsi_wcr:%08X, "\n";
    __message "    GPIOE.MODER=0x", gpioe_moder:%08X, "  GPIOC.MODER=0x", gpioc_moder:%08X, "\n";
}

/* --- BP action: log + cycle count + comprehensive register dump --- */
HitSystemInit()
{
    __message "\n[BP-HIT] SystemInit entry (early Reset_Handler -> SystemInit -> main)\n";
    ReadCycle();
    DumpKeyRegs();
    __message "[BP-HIT] action complete\n";
}

HitMpuConfig()
{
    __message "\n[BP-HIT] MPU_Config entry (in main, before peripheral inits)\n";
    ReadCycle();
    DumpKeyRegs();
    __message "[BP-HIT] action complete\n";
}

HitSystemClockConfig()
{
    __message "\n[BP-HIT] SystemClock_Config entry (about to switch to PLL)\n";
    ReadCycle();
    DumpKeyRegs();
    __message "[BP-HIT] action complete\n";
}

HitVTaskStartScheduler()
{
    __message "\n[BP-HIT] vTaskStartScheduler entry (end of Phase 1 silent boot)\n";
    ReadCycle();
    DumpKeyRegs();
    __message "[BP-HIT] action complete\n";
}

execUserSetup()
{
    __var bp_si, bp_mpu, bp_clk, bp_vts;

    __message "\n*** boot_pipeline.mac (action-on-BP probe) ***\n";
    __message "    4 BPs installed across the boot path.\n";

    bp_si  = __setCodeBreak("SystemInit",         0, "1", "TRUE", "HitSystemInit()");
    bp_mpu = __setCodeBreak("MPU_Config",         0, "1", "TRUE", "HitMpuConfig()");
    bp_clk = __setCodeBreak("SystemClock_Config", 0, "1", "TRUE", "HitSystemClockConfig()");
    bp_vts = __setCodeBreak("vTaskStartScheduler",0, "1", "TRUE", "HitVTaskStartScheduler()");

    __message "[SETUP] BP handles -- SystemInit=", bp_si:%d,
              "  MPU_Config=", bp_mpu:%d,
              "  SystemClock_Config=", bp_clk:%d,
              "  vTaskStartScheduler=", bp_vts:%d, "\n";
    __message "[SETUP] returning -- CPU starts running.\n\n";
}

execUserExit()
{
    __message "\n=========================================================\n";
    __message "[EXIT] boot_pipeline.mac session ending\n";
    __message "=========================================================\n";
}
