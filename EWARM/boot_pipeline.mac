/*
 * boot_pipeline.mac -- Sequential boot probe via __hwRunToBreakpoint.
 *
 * Per UCSARM-26 v9.50.x:
 *   __hwRunToBreakpoint(address, timeout_ms) -- runs CPU until the BP
 *      at `address` fires.  Returns elapsed ms, or negative on failure
 *      (-1 = BP install failure, -2 = timeout).
 *   Symbols are NOT supported as address; resolve via __symbolAddress.
 *
 * Flow (in execUserSetup, single linear macro):
 *   1. Resolve all 20 boot-stage symbol addresses.
 *   2. Sequentially run-to-BP at each checkpoint and snapshot peripheral
 *      state. The CPU advances naturally from one checkpoint to the next.
 *   3. Final snapshot at TouchGFX_Task entry.
 *
 * Note: SystemInit runs in the startup code BEFORE main(), so we can't
 * sample it via this approach -- the first observable checkpoint is main.
 *
 * Driver support: J-Link OK per UCSARM-26.
 */

/* --- helpers --- */

ReadCycle()
{
    __var c;
    c = __readMemory32(0xE0001004, "Memory");
    __message "    cyc=0x", c:%08X, "\n";
}

DumpKeyRegs()
{
    /* Comprehensive boot-state dump.  All addresses are peripheral
     * apertures that are always alive (RCC, FLASH, PWR, FMC, LTDC, DSI,
     * MPU, GPIO).  SDRAM (0xD0000000) is NOT read here -- it would bus-
     * fault before MX_FMC_Init and abort the macro. */
    __var rcc_cr, rcc_cfgr, rcc_pllckselr, rcc_d1cfgr;
    __var rcc_ahb1, rcc_ahb3, rcc_ahb4, rcc_apb2enr, rcc_apb3enr;
    __var flash_acr, pwr_d3cr;
    __var fmc_sdcr1, mpu_ctrl, scb_ccr;
    __var ltdc_gcr, ltdc_isr, ltdc_l1pfcr, ltdc_l1cfbar;
    __var dsi_cr, dsi_wcr;
    __var gpioe_moder, gpioc_moder;

    rcc_cr        = __readMemory32(0x58024400, "Memory");
    rcc_cfgr      = __readMemory32(0x58024410, "Memory");
    rcc_pllckselr = __readMemory32(0x58024428, "Memory");
    rcc_d1cfgr    = __readMemory32(0x58024418, "Memory");
    rcc_ahb1      = __readMemory32(0x580244D8, "Memory");
    rcc_ahb3      = __readMemory32(0x580244D4, "Memory");
    rcc_ahb4      = __readMemory32(0x580244E0, "Memory");
    rcc_apb2enr   = __readMemory32(0x580244F0, "Memory");
    rcc_apb3enr   = __readMemory32(0x580244E4, "Memory");
    flash_acr     = __readMemory32(0x52002000, "Memory");
    pwr_d3cr      = __readMemory32(0x58024818, "Memory");
    fmc_sdcr1     = __readMemory32(0x52004140, "Memory");
    mpu_ctrl      = __readMemory32(0xE000ED94, "Memory");
    scb_ccr       = __readMemory32(0xE000ED14, "Memory");
    ltdc_gcr      = __readMemory32(0x50001018, "Memory");
    ltdc_isr      = __readMemory32(0x50001038, "Memory");
    ltdc_l1pfcr   = __readMemory32(0x50001094, "Memory");
    ltdc_l1cfbar  = __readMemory32(0x500010AC, "Memory");
    dsi_cr        = __readMemory32(0x50000004, "Memory");
    dsi_wcr       = __readMemory32(0x50000024, "Memory");
    gpioe_moder   = __readMemory32(0x58021000, "Memory");
    gpioc_moder   = __readMemory32(0x58020800, "Memory");

    __message "    RCC.CR=0x",   rcc_cr:%08X,        "  CFGR=0x",      rcc_cfgr:%08X,
              "  PLLCKSEL=0x",   rcc_pllckselr:%08X, "  D1CFGR=0x",    rcc_d1cfgr:%08X, "\n";
    __message "    AHB1=0x",     rcc_ahb1:%08X,      "  AHB3=0x",      rcc_ahb3:%08X,
              "  AHB4=0x",       rcc_ahb4:%08X,      "  APB2=0x",      rcc_apb2enr:%08X,
              "  APB3=0x",       rcc_apb3enr:%08X, "\n";
    __message "    FLASH=0x",    flash_acr:%08X,     "  PWR.D3CR=0x",  pwr_d3cr:%08X,
              "  FMC.SDCR1=0x",  fmc_sdcr1:%08X, "\n";
    __message "    MPU.CTRL=0x", mpu_ctrl:%08X,      "  SCB.CCR=0x",   scb_ccr:%08X, "\n";
    __message "    LTDC.GCR=0x", ltdc_gcr:%08X,      "  ISR=0x",       ltdc_isr:%08X,
              "  L1PFCR=0x",     ltdc_l1pfcr:%08X,   "  L1CFBAR=0x",   ltdc_l1cfbar:%08X, "\n";
    __message "    DSI.CR=0x",   dsi_cr:%08X,        "  WCR=0x",       dsi_wcr:%08X, "\n";
    __message "    GPIOE.MODER=0x", gpioe_moder:%08X, "  GPIOC.MODER=0x", gpioc_moder:%08X, "\n";
}

/* RunToCheckpoint(addr, timeout_ms, label)
 * Wraps __hwRunToBreakpoint with elapsed-time and snapshot output. */
RunToCheckpoint(addr, timeout_ms, label)
{
    __var elapsed;
    __message "\n>>> running to ", label, " (addr=0x", addr:%08X, ", timeout=", timeout_ms:%d, "ms) ...\n";
    elapsed = __hwRunToBreakpoint(addr, timeout_ms);
    if (elapsed < 0) {
        __message "    [FAIL] __hwRunToBreakpoint returned ", elapsed:%d,
                  " (-1=BP install fail, -2=timeout)\n";
        return;
    }
    __message "    [OK] reached after ", elapsed:%d, "ms (host-side, +-5-20ms)\n";
    ReadCycle();
    DumpKeyRegs();
}

execUserSetup()
{
    __var addr;

    __message "\n*** boot_pipeline.mac (sequential RunToBp) ***\n";
    __message "    UCSARM-26 v9.50.x: __hwRunToBreakpoint(addr,timeout_ms)\n";
    __message "    Symbols resolved via __symbolAddress (per docs).\n";

    /* Phase 1 checkpoints (pre-osKernelStart) */
    addr = __symbolAddress("main");                   RunToCheckpoint(addr, 5000, "main");
    addr = __symbolAddress("MPU_Config");             RunToCheckpoint(addr, 5000, "MPU_Config");
    addr = __symbolAddress("SystemClock_Config");     RunToCheckpoint(addr, 5000, "SystemClock_Config");
    addr = __symbolAddress("MX_GPIO_Init");           RunToCheckpoint(addr, 5000, "MX_GPIO_Init");
    addr = __symbolAddress("MX_MDMA_Init");           RunToCheckpoint(addr, 5000, "MX_MDMA_Init");
    addr = __symbolAddress("MX_FMC_Init");            RunToCheckpoint(addr, 5000, "MX_FMC_Init");
    addr = __symbolAddress("MX_DMA2D_Init");          RunToCheckpoint(addr, 5000, "MX_DMA2D_Init");
    addr = __symbolAddress("MX_CRC_Init");            RunToCheckpoint(addr, 5000, "MX_CRC_Init");
    addr = __symbolAddress("MX_JPEG_Init");           RunToCheckpoint(addr, 5000, "MX_JPEG_Init");
    addr = __symbolAddress("MX_UART8_Init");          RunToCheckpoint(addr, 5000, "MX_UART8_Init");
    addr = __symbolAddress("MX_QUADSPI_Init");        RunToCheckpoint(addr, 5000, "MX_QUADSPI_Init");
    addr = __symbolAddress("MX_TouchGFX_PreOSInit");  RunToCheckpoint(addr, 5000, "MX_TouchGFX_PreOSInit");
    addr = __symbolAddress("osKernelInitialize");     RunToCheckpoint(addr, 5000, "osKernelInitialize");
    addr = __symbolAddress("osThreadNew");            RunToCheckpoint(addr, 5000, "osThreadNew");
    addr = __symbolAddress("vTaskStartScheduler");    RunToCheckpoint(addr, 5000, "vTaskStartScheduler");

    /* Phase 2 checkpoints (inside guiTask, post-scheduler-start) */
    addr = __symbolAddress("TouchGFX_Task");          RunToCheckpoint(addr, 5000, "TouchGFX_Task entry (Phase 2 begin)");
    addr = __symbolAddress("MX_DSIHOST_DSI_Init");    RunToCheckpoint(addr, 5000, "MX_DSIHOST_DSI_Init");
    addr = __symbolAddress("MX_LTDC_Init");           RunToCheckpoint(addr, 5000, "MX_LTDC_Init");

    __message "\n*** boot_pipeline.mac DONE -- all checkpoints visited ***\n";
}

execUserExit()
{
    __message "[EXIT] session ending\n";
}
