/* clock_test_check.jlink — live DAP register monitoring. No halts. CPU runs free.
 *
 * 16 REGISTERS PER SAMPLE:
 *
 *  ── PLL / clock source diagnosis (NEW — 23.3 kHz root cause) ──────────────
 *  [01] 0x58024400  RCC_CR         HSIDIV[4:3] HSI=64MHz÷div  PLL1RDY[24] PLL2RDY[26] PLL3RDY[28]
 *  [02] 0x58024450  RCC_D1CCIPR    CKPERSEL[29:28] 00=HSI 01=CSI 10=HSE → feeds per_ck
 *  [03] 0x58024418  RCC_D3CFGR     D3PPRE[6:4] APB4 prescaler
 *
 *  ── Clock enable "life support" ───────────────────────────────────────────
 *  [04] 0x580244F4  RCC_APB4ENR    bit21=SAI4EN  (want 1)
 *  [05] 0x580244E0  RCC_AHB4ENR    bit4=GPIOEEN  bit21=BDMAEN  (both want 1)
 *
 *  ── Clock source mux ──────────────────────────────────────────────────────
 *  [06] 0x58024458  RCC_D3CCIPR    SAI4ASEL[23:21] 000=PLL2P 001=PLL3P 010=I2S 011=per_ck
 *
 *  ── SAI4 ──────────────────────────────────────────────────────────────────
 *  [07] 0x58005404  SAI4 CR1       SAIEN[16]=1  MODE[1:0]=01  MCKDIV[24:20]=16
 *  [08] 0x58005444  SAI4 PDMCR     want 0x00000101
 *  [09] 0x58005418  SAI4 SR        bit6=OVRUDR want 0
 *
 *  ── GPIO PE2 ──────────────────────────────────────────────────────────────
 *  [10] 0x58021000  GPIOE MODER    PE2[5:4]=10 (AF)
 *  [11] 0x58021020  GPIOE AFRL     PE2[11:8]=0xA (AF10=SAI4_CK1)
 *  [12] 0x58021008  GPIOE OSPEEDR  PE2[5:4]=11 (Very High)
 *
 *  ── BDMA Channel1 ─────────────────────────────────────────────────────────
 *  [13] 0x5802541C  BDMA Ch1 CCR   EN[0]=1  CIRC[5]=1
 *  [14] 0x58025420  BDMA Ch1 CNDTR live count 1-8
 *  [15] 0x58025424  BDMA Ch1 CPAR  want 0x58005420
 *  [16] 0x58025428  BDMA Ch1 CM0AR want 0x38000000
 *
 *  ── Static (read once) ────────────────────────────────────────────────────
 *  [S1] 0x580244A8  RCC_D3AMR      autonomous mode gates
 */

