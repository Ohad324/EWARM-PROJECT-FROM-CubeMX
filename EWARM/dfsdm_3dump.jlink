mem32 0x40017104 1
mem32 0x40017108 1
mem32 0x40017114 1
mem32 0x4001711C 1
mem32 0x58005404 1
mem32 0x58005408 1
mem32 0x58005410 1
mem32 0x58005418 1
mem32 0x58005420 1
mem32 0x58005444 1
mem32 0x58005448 1
mem32 0x40020028 1
mem32 0x4002002C 1
mem32 0x40020030 1
mem32 0x40020034 1
mem32 0x40020000 1
mem32 0x58020800 1
