                        <name>CCDefines</name>
                        <state>CORE_CM7</state>
                        <state>USE_HAL_DRIVER</state>
                        <state>STM32H747xx</state>
                        <state>USE_BPP=24</state>
                        <state>USE_PWR_DIRECT_SMPS_SUPPLY</state>
                        <state>FLATBUFFERS_USE_STD_OPTIONAL=0</state>
                        <state>TF_LITE_STATIC_MEMORY</state>
                        <state>EI_CLASSIFIER_ALLOCATION_STATIC=1</state>
                        <state>EI_TENSOR_ARENA_LOCATION=.sram1</state>
                        <state>WAKE_WORD_TEST=1</state>
                        <state>EIDSP_USE_CMSIS_DSP=0</state>
                        <state>EI_CLASSIFIER_TFLITE_ENABLE_CMSIS_NN=0</state>
                        <state>EI_PORTING_IAR</state>
