/*
 * lcd_debug.mac — C-SPY macro: 5 HW breakpoints for LCD + UART diagnosis
 *
 * Uses short filenames only (no full paths) — IAR resolves them via project.
 *
 * STAGE 1 — DMA arm result (ORE fix verification)
 *   BP1 — ble_uart.c:272   "DMA armed OK"  → fix worked
 *   BP2 — ble_uart.c:266   "DMA arm FAIL"  → fix didn't work
 *
 * STAGE 2 — NORA data arriving
 *   BP3 — ble_uart.c:368   xQueueSendFromISR → ISR received bytes from NORA
 *
 * STAGE 3 — TouchGFX display pipeline
 *   BP4 — TouchGFXHAL.cpp:132   taskEntry         → TouchGFX task alive
 *   BP5 — TouchGFXHAL.cpp:447   EndOfRefreshCB    → DSI refreshed panel
 *
 * Load via: Project → Options → Debugger → Setup → Use macro file
 * Verify loaded: look for "lcd_debug.mac loaded" in Debug Log window.
 */

execUserSetup()
{
    message "lcd_debug.mac: setting BPs...\n";

    /* STAGE 1 */
    __setHWCodeBreak("{ble_uart.c}272", 0, "1", "TRUE", "");
    __setHWCodeBreak("{ble_uart.c}266", 0, "1", "TRUE", "");

    /* STAGE 2 */
    __setHWCodeBreak("{ble_uart.c}368", 0, "1", "TRUE", "");

    /* STAGE 3 */
    __setHWCodeBreak("{TouchGFXHAL.cpp}132", 0, "1", "TRUE", "");
    __setHWCodeBreak("{TouchGFXHAL.cpp}447", 0, "1", "TRUE", "");

    message "lcd_debug.mac loaded — 5 HW BPs set.\n";
    message "BP1=DMA_OK  BP2=DMA_FAIL  BP3=NORA_ISR  BP4=TFX_ENTRY  BP5=DSI_REFRESH\n";
}
